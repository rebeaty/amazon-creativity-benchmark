            "\n",
            "\\author{Seonghyeon Ye{\\textsuperscript{1}\\thanks{~~Work done while interning at LG AI Research.}} \\quad Doyoung Kim{\\textsuperscript{1}}\\quad Joel Jang{\\textsuperscript{1}\\footnotemark[1]}\\quad Joongbo Shin{\\textsuperscript{2}} \\quad Minjoon Seo{\\textsuperscript{1}} \\\\  \\\\\n",
            "{\\textsuperscript{1}}KAIST\\quad{\\textsuperscript{2}}LG AI Research\\\\ \n",
            "\\texttt{\\{seonghyeon.ye,ikevin98,joeljang,minjoon\\}@kaist.ac.kr} \\\\\n",
