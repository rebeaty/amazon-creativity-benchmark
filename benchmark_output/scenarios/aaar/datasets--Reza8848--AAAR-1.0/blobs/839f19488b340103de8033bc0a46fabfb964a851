            "\\textit{\\# Output (a):}\\\\\n",
            "\\textbf{\\{Output 1\\}}\\\\\n",
            "\\textit{\\# Output (b):}\\\\\n",
            "\\textbf{\\{Output 2\\}}\\\\\n",
