            "    \"Vicuna\",\n",
            "]\n",
            "\n",
            "for species in species_list:\n",
            "    image = hugging_face_tool_agent.run(f\"Draw me a picture of a {species}\")\n",
            "    image.save(f\"./{species}_image.png\")\n",
            "\\end{lstlisting}\n",
            "\t\t\\includegraphics[width=\\textwidth]{figures/camelidae.pdf}\n",
            "\t\\end{AIBox}\n",
