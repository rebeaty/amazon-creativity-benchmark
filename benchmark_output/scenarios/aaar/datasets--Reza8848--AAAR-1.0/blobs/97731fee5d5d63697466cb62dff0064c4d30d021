            "    \\centering\n",
            "    \\small\n",
            "    \n",
            "    \\begin{tabular}{lr}\n",
            "    \\hline\n",
            "    \\toprule\n",
            "    statistic &  \\\\ \n",
            "    \\midrule\n",
            "    \\# of tasks & 1616 \\\\\n",
