        "\\author{\n",
        "Haotian Liu$^{1*}$, Chunyuan Li$^{2*}$, Qingyang Wu$^{3}$, Yong Jae Lee$^{1}$ \\\\\n",
        "$^{1}$University of Wisconsin--Madison~~~~~~$^2$Microsoft Research~~~~~~$^3$Columbia University \\\\\n",
