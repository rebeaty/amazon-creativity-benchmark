        "\\begin{align} \\label{eq:organize_data_turn_rule}\n",
        " \\Xmat_{\\texttt{instruct}}^t = \n",
        "\\left\\{\\begin{matrix}\n",
        "& \\text{Randomly choose}~~\n",
        "[\\Xmat_{\\texttt{q}}^1, \\Xmat_{\\texttt{v}}] ~~\\text{or}~~ [ \\Xmat_{\\texttt{v}}, \\Xmat_{\\texttt{q}}^1] ,  ~~~\\text{the first turn}~t=1 \\\\ \n",
