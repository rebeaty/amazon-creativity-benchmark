            "\\item Compute the loss and update $\\theta$ using gradient descent\n",
            "\\algorithmiccomment{Learning}\n",
            "\\ENDFOR\n",
            "\\ENDFOR\n",
            "\n",
            "\\end{algorithmic}\n",
            "\n",
            "\\caption{Self-corrective learning}\n",
            "\\label{alg:main}\n",
            "\\end{algorithm}\n",
            "\\vspace{-1em}\n",
            "\\end{figure}\n",
