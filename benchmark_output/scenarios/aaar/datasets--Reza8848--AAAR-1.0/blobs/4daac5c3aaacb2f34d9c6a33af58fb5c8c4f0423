        "\\section{Introduction}\n",
        "\\vspace{-2mm}\n",
        "\\begin{figure*}[h]\n",
        "  \\centering\n",
        "  \\includegraphics[width=1.0\\linewidth]{figures/Figure2-v4-5.pdf}  \n",
        " \\vspace{-1.5em}\n",
