            "\n",
            "\\author{Zhengbao Jiang$^1$\\thanks{~~Lead contributors.} \\quad Frank F. Xu$^1$\\footnotemark[1] \\quad Luyu Gao$^1$\\footnotemark[1] \\quad Zhiqing Sun$^1$\\footnotemark[1] \\quad Qian Liu$^2$ \\\\\n",
