            "\n",
            "\\begin{equation}\n",
            "\n",
            "i'_{v,c} = \\frac{\\exp(\\text{log}(z_{v,c}) + g_c)/\\tau)}{\\sum^C_{j=1} \\exp(\\text{log}(z_{v,j}) + g_j)/\\tau)},\n",
            "\\label{eq:gumbel}\n",
            "\\end{equation}\n",
            "}\n",
            "\\noindent where  $\\tau$ is a temperature parameter, and  $\\mathbf{g} \\in \\mathbb{R}^{|V|}$ corresponds to samples from the Gumbel distribution $g_j \\sim - \\log(- \\log(u_j))$\n",
