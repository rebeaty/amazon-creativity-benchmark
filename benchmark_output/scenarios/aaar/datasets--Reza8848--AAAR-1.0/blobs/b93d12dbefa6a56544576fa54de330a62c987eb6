            "    } & \n",
            "    \\makecell[l]{\n",
            "        {\\em L} \\\\ \\cmark \\\\ \\cmark \\\\ \\cmark \\\\ \\cmark \\\\ \\xmark \\\\ \\xmark \\\\ \\xmark \\\\ \\\\ \\\\ \\\\ \\\\ \\\\\n",
            "    } & \n",
            "    \\makecell[l]{\n",
            "        {\\em I} \\\\ \\cmark \\\\ \\cmark \\\\ \\xmark \\\\ \\xmark \\\\ \\cmark \\\\ \\cmark \\\\ \\xmark \\\\ \\\\ \\\\ \\\\ \\\\ \\\\\n",
            "    } & \n",
            "    \\makecell[l]{\n",
            "        {\\em M} \\\\ \\cmark \\\\ \\xmark \\\\ \\xmark \\\\ \\xmark \\\\ \\xmark \\\\ \\xmark \\\\ \\xmark \\\\ \\\\ \\\\ \\\\ \\\\ \\\\\n",
