    "predicted_text": "\u0418\u0442\u0430\u043a, \u0441\u043b\u0443\u0448\u0430\u0439\u0442\u0435, \u0434\u0440\u0443\u0437\u044c\u044f \u043c\u043e\u0438, \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u044f, \u0432\u0430\u0448 \u043f\u043e\u043a\u043e\u0440\u043d\u044b\u0439 \u0441\u043b\u0443\u0433\u0430, \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0441\u044f \u043d\u0430 \u043f\u043e\u0438\u0441\u043a\u0438 \u043a\u043b\u0430\u0434\u0430. \u041d\u0435\u0442, \u043d\u0435 \u0442\u043e\u0433\u043e, \u0447\u0442\u043e \u0432\u044b \u043f\u043e\u0434\u0443\u043c\u0430\u043b\u0438, \u0441 \u043f\u0438\u0440\u0430\u0442\u0441\u043a\u0438\u043c\u0438 \u0448\u043b\u044f\u043f\u0430\u043c\u0438 \u0438 \u043f\u043e\u043f\u0443\u0433\u0430\u044f\u043c\u0438 \u043d\u0430 \u043f\u043b\u0435\u0447\u0430\u0445. \u042d\u0442\u043e \u0431\u044b\u043b \u0432\u043f\u043e\u043b\u043d\u0435 \u0441\u0435\u0431\u0435 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u043a\u043b\u0430\u0434 \u2013 \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u0430\u0440\u0442\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044f \u043c\u043d\u0435 \u043e\u0442 \u0442\u0440\u043e\u044e\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0435\u0434\u0443\u0448\u043a\u0438, \u0431\u044b\u0432\u0448\u0435\u0433\u043e \u043a\u043b\u0430\u0434\u043e\u0438\u0441\u043a\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0441\u0443\u0434\u044f \u043f\u043e \u0432\u0441\u0435\u043c\u0443, \u0431\u044b\u043b \u043d\u0435\u043c\u043d\u043e\u0433\u043e\u2026 \u044d\u043a\u0441\u0446\u0435\u043d\u0442\u0440\u0438\u0447\u043d\u044b\u043c.\n\n\u041a\u0430\u0440\u0442\u0430, \u043a\u0441\u0442\u0430\u0442\u0438, \u0431\u044b\u043b\u0430 \u0448\u0435\u0434\u0435\u0432\u0440\u043e\u043c! \u041d\u0430\u0440\u0438\u0441\u043e\u0432\u0430\u043d\u0430, \u0432\u0438\u0434\u0438\u043c\u043e, \u043d\u0430 \u043a\u043b\u043e\u0447\u043a\u0435 \u0442\u0443\u0430\u043b\u0435\u0442\u043d\u043e\u0439 \u0431\u0443\u043c\u0430\u0433\u0438, \u0441 \u043d\u0430\u0434\u043f\u0438\u0441\u044f\u043c\u0438 \u0432\u0440\u043e\u0434\u0435: \"\u0422\u0443\u0442 \u0431\u0443\u0434\u0435\u0442 X, \u0435\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u0431\u043b\u0443\u0434\u0438\u0448\u044c\u0441\u044f!\", \"\u041e\u043f\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044c \u0437\u043b\u043e\u0431\u043d\u044b\u0445 \u0431\u0435\u043b\u043e\u043a!\" \u0438 \"\u041f\u043e\u043c\u043d\u0438! \u041a\u043b\u0430\u0434 \u043b\u044e\u0431\u0438\u0442 \u043f\u0435\u0442\u044c \u043f\u0435\u0441\u043d\u0438!\" (\u043a\u0430\u043a\u043e\u0439 \u043a\u043b\u0430\u0434, \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u043b\u044e\u0431\u0438\u0442 \u043f\u0435\u0442\u044c \u043f\u0435\u0441\u043d\u0438?).\n\n\u0421\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0434 \u0441\u0442\u0430\u0442\u044c: \u0441\u0442\u0430\u0440\u044b\u0439 \u0440\u044e\u043a\u0437\u0430\u043a, \u0434\u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044f \u043e\u0442 \u0442\u043e\u0433\u043e \u0436\u0435 \u0434\u0435\u0434\u0443\u0448\u043a\u0438 (\u043f\u0430\u0445\u043d\u0443\u0449\u0438\u0439 \u0441\u044b\u0440\u043e\u0441\u0442\u044c\u044e \u0438 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u044f\u043c\u0438 \u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043d\u0435 \u0441\u0430\u043c\u044b\u0445 \u0443\u0434\u0430\u0447\u043d\u044b\u0445 \u043a\u043b\u0430\u0434\u043e\u0438\u0441\u043a\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0445 \u043f\u043e\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f\u0445), \u043b\u043e\u043f\u0430\u0442\u0430, \u0440\u0430\u0437\u043c\u0435\u0440\u043e\u043c \u0441 \u043c\u043e\u044e \u0440\u0443\u043a\u0443 (\u043e \u0447\u0435\u043c \u044f \u043f\u043e\u0436\u0430\u043b\u0435\u043b \u0431\u0443\u043a\u0432\u0430\u043b\u044c\u043d\u043e \u0447\u0435\u0440\u0435\u0437 \u043f\u044f\u0442\u044c \u043c\u0438\u043d\u0443\u0442), \u0438 \u043f\u043e\u0445\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0441\u0442\u044e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044f \u0441\u0442\u044b\u0440\u0438\u043b \u0443 \u0441\u0432\u043e\u0435\u0439 \u0431\u0430\u0431\u0443\u0448\u043a\u0438. \u0414\u0430, \u0432\u044b \u043d\u0435 \u043e\u0441\u043b\u044b\u0448\u0430\u043b\u0438\u0441\u044c, \u0443 \u0431\u0430\u0431\u0443\u0448\u043a\u0438. \u041e\u043d\u0430, \u0432\u0438\u0434\u0438\u0442\u0435 \u043b\u0438, \u0443\u0432\u043b\u0435\u043a\u0430\u043b\u0430\u0441\u044c \u0439\u043e\u0433\u043e\u0439, \u0438 \u044d\u0442\u043e\u0442 \u043a\u043e\u0441\u0442\u044e\u043c \u0446\u0432\u0435\u0442\u0430 \"\u0432\u044b\u0440\u0432\u0438 \u0433\u043b\u0430\u0437\" \u0431\u044b\u043b, \u043f\u043e \u0435\u0435 \u0441\u043b\u043e\u0432\u0430\u043c, \"\u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u043c \u0434\u043b\u044f \u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0441 \u043f\u0440\u0438\u0440\u043e\u0434\u043e\u0439\". \u0427\u0442\u043e \u0436, \u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0443 \u043c\u0435\u043d\u044f \u0431\u044b\u043b\u043e \u0432\u044b\u0448\u0435 \u043a\u0440\u044b\u0448\u0438, \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043a\u043e\u0433\u0434\u0430 \u044f, \u0432 \u044d\u0442\u0438\u0445 \u043e\u0431\u0442\u044f\u0433\u0438\u0432\u0430\u044e\u0449\u0438\u0445 \u043b\u043e\u0441\u0438\u043d\u0430\u0445, \u043f\u043e\u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043f\u0435\u0440\u0435\u043f\u0440\u044b\u0433\u043d\u0443\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0440\u0443\u0447\u0435\u0439.\n\n\u041b\u0435\u0441 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043b \u043c\u0435\u043d\u044f \u0432\u043e \u0432\u0441\u0435\u0439 \u0441\u0432\u043e\u0435\u0439 \u043a\u0440\u0430\u0441\u0435. \u041f\u0442\u0438\u0447\u043a\u0438 \u043f\u0435\u043b\u0438, \u0441\u043e\u043b\u043d\u044b\u0448\u043a\u043e \u0441\u0432\u0435\u0442\u0438\u043b\u043e, \u0430 \u043a\u043e\u043c\u0430\u0440\u044b\u2026 \u043a\u043e\u043c\u0430\u0440\u044b \u0431\u044b\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u0432 \u0432\u043e\u0441\u0442\u043e\u0440\u0433\u0435 \u043e\u0442 \u043c\u043e\u0435\u0433\u043e \"\u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u043b\u044f \u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0441 \u043f\u0440\u0438\u0440\u043e\u0434\u043e\u0439\" \u043a\u043e\u0441\u0442\u044e\u043c\u0430. \u042f, \u043f\u043e\u0447\u0435\u0441\u044b\u0432\u0430\u044f\u0441\u044c \u0438 \u043c\u0430\u0442\u0435\u0440\u044f\u0441\u044c (\u043f\u0440\u043e\u0441\u0442\u0438\u0442\u0435 \u043c\u043e\u0439 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439, \u043d\u043e \u043d\u0435\u0440\u0432\u044b \u0441\u0434\u0430\u0432\u0430\u043b\u0438!), \u043d\u0430\u0447\u0430\u043b \u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f\u043c \u043a\u0430\u0440\u0442\u044b.\n\n\u041f\u0435\u0440\u0432\u0430\u044f \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u2013 \"\u0414\u0435\u0440\u0435\u0432\u043e \u0441 \u0442\u0440\u0435\u043c\u044f \u0433\u043b\u0430\u0437\u0430\u043c\u0438\". \u042f, \u043a\u043e\u043d\u0435\u0447\u043d\u043e, \u043d\u0435 \u0437\u043d\u0430\u043b, \u0447\u0442\u043e \u044d\u0442\u043e \u0437\u0430 \u0434\u0435\u0440\u0435\u0432\u043e, \u043d\u043e, \u0441\u0443\u0434\u044f \u043f\u043e \u043a\u0430\u0440\u0442\u0435, \u043e\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u044b\u0442\u044c \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c. \u041f\u043e\u043b\u0447\u0430\u0441\u0430 \u044f \u0448\u0430\u0440\u0438\u043b \u043f\u043e \u043b\u0435\u0441\u0443, \u043f\u043e\u043a\u0430 \u043d\u0435 \u043d\u0430\u0442\u043a\u043d\u0443\u04