  "groups": [
    "creativity",
    "dialogue_diversity"
  ],
  "annotators": [
    {
      "class_name": "llm_judge.generic_llm_judge_annotator.GenericLLMJudgeAnnotator",
      "args": {
        "judge_model_name": "google/gemini-2.0-flash-lite",
        "judge_temperature": 0.0,
        "judge_max_new_tokens": 64,
        "metric_name": "coherence_score",
        "rubric": "Evaluate the COHERENCE of the generated dialogue response.\nConsider whether the response logically follows from the conversation context and maintains conversational coherence.\n\nScore 1: Response is completely incoherent or off-topic for the dialogue\nScore 2: Response has major coherence issues with the preceding conversation\nScore 3: Response is somewhat coherent but with noticeable gaps\nScore 4: Response is coherent and follows naturally from the dialogue\nScore 5: Response is perfectly coherent, natural, and contextually appropriate\n"
      }
    }
  ]
}